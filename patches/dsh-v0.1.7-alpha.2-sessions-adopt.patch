+/**
+ * The window verbs one adopted Session's owner drives.
+ *
+ * An adopted Session is one whose history this client owns: a feature adopted it
+ * under a synthetic identity and feeds it the events it has, instead of the Host
+ * answering for a log it has never seen. Everything downstream 閳?the catalog,
+ * the reference allocator, the conversation renderer 閳?then treats it as an
+ * ordinary Session, which is the entire point: the renderer is the product's own
+ * rather than a copy of it.
+ *
+ * @module @deepseek-ai/dsh-api-session-controller/client/sessions/adopted
+ */
+
+import type { SessionId, SessionEvent } from '@deepseek-ai/dsh-session/types'
+import { SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type { LlmAttemptId } from '@deepseek-ai/dsh-llm/brand'
+import type { AssistantStreamRecord } from '@deepseek-ai/dsh-llm/assistant-stream'
+import type { SessionAssistantStreamFrame } from '../../types.ts'
+import type { SessionLiveEventEntry } from '../contract/events.ts'
+import type { AdoptedSession } from '../contract/sessions.ts'
+import type { Session } from './session.ts'
+
+/** One live attempt's frame bookkeeping, as the fold's dense protocol requires. */
+interface LiveAttempt {
+  revision: number
+  /** Next dense chunk index; the fold rebaselines on any gap. */
+  nextIndex: number
+  /** Text already sent, so a whole-text update can be reduced to its delta. */
+  text: string
+  turn: number
+  step: number
+  /** Last durable sequence seen when the attempt opened. */
+  startedAfterSeq: number
+}
+
+/**
+ * One adopted Session, and the frames its owner feeds it.
+ *
+ * Every method is safe after {@link release}: an owner that is tearing down may
+ * still have a frame in flight, and a released Session must swallow it rather
+ * than write into a generation nobody holds.
+ */
+export class AdoptedSessionHandle implements AdoptedSession {
+  private readonly attempts = new Map<string, LiveAttempt>()
+  private revision = 0
+  private lastSeq = -1
+  private released = false
+
+  /**
+   * @param session - the resident Session this handle drives.
+   * @param drop - retire the generation; supplied by the Sessions service.
+   */
+  constructor(
+    readonly sessionId: SessionId,
+    private readonly session: Session,
+    private readonly drop: () => void,
+  ) {}
+
+  /**
+   * Replace the whole window.
+   * @param events - wire envelopes, in log order.
+   * @param hasMore - whether older history is reachable; false for a mirror.
+   */
+  replace(events: readonly SessionEvent[], hasMore: boolean): void {
+    if (this.released) return
+    // A replaced window is a different conversation: any attempt folded against
+    // the old one can no longer be settled by anything that follows.
+    this.attempts.clear()
+    this.lastSeq = -1
+    const entries = events.map(entryOf)
+    for (const entry of entries) this.observe(entry.event.seq)
+    this.session.adoptWindow(entries, hasMore)
+  }
+
+  /**
+   * Append one durable event.
+   * @param event - the wire envelope.
+   */
+  append(event: SessionEvent): void {
+    if (this.released) return
+    const entry = entryOf(event)
+    this.observe(entry.event.seq)
+    this.session.adoptDurable(entry)
+  }
+
+  /**
+   * Show the whole text of one running attempt, replacing what was shown.
+   *
+   * The wire form of live Assistant text is a dense run of chunks; this client
+   * is handed the text so far instead, because that is what a relay can carry
+   * without buffering. The delta is computed here, and a text that is not an
+   * extension of the last one restarts the attempt rather than inventing a
+   * chunk the fold would rebaseline on.
+   * @param attempt - the attempt, its position, and the text so far.
+   */
+  live(attempt: {
+    attemptId: string
+    turn: number
+    step: number
+    kind: 'text' | 'reasoning'
+    text: string
+    time?: number
+  }): void {
+    if (this.released) return
+    let live = this.attempts.get(attempt.attemptId)
+    if (live !== undefined && (!attempt.text.startsWith(live.text) || live.turn !== attempt.turn)) {
+      this.end(attempt.attemptId, { kind: 'abandoned' })
+      live = undefined
+    }
+    if (live === undefined) {
+      this.revision += 1
+      live = {
+        revision: this.revision,
+        nextIndex: 0,
+        text: '',
+        turn: attempt.turn,
+        step: attempt.step,
+        startedAfterSeq: this.lastSeq,
+      }
+      this.attempts.set(attempt.attemptId, live)
+      this.frame({
+        type: 'start',
+        attemptId: attempt.attemptId as LlmAttemptId,
+        revision: live.revision,
+        // -1 means "nothing durable yet", the same value the fold's own callers
+        // use for an attempt that opened on an empty window.
+        startedAfterSeq: live.startedAfterSeq === -1 ? -1 : SessionSeq(live.startedAfterSeq),
+        turn: attempt.turn,
+        step: attempt.step,
+      })
+    }
+    const delta = attempt.text.slice(live.text.length)
+    if (delta === '') return
+    live.text = attempt.text
+    // One record per chunk, carrying one text delta: the same shape the Host
+    // mints, so the renderer's own fold expands it without a special case.
+    const record: AssistantStreamRecord = {
+      type: attempt.kind === 'reasoning' ? 'reasoning-chunks' : 'text-chunks',
+      time0: attempt.time ?? Date.now(),
+      index: 0,
+      dt: [0],
+      texts: [delta],
+    }
+    this.frame({
+      type: 'chunk',
+      attemptId: attempt.attemptId as LlmAttemptId,
+      revision: live.revision,
+      index: live.nextIndex,
+      time: attempt.time ?? Date.now(),
+      chunk: record as never,
+    })
+    live.nextIndex += 1
+  }
+
+  /**
+   * Settle one attempt with its durable end.
+   * @param settlement - the attempt and the durable event that ended it.
+   */
+  settle(settlement: { attemptId: string; event: SessionEvent }): void {
+    if (this.released) return
+    const entry = entryOf(settlement.event)
+    this.observe(entry.event.seq)
+    // The durable entry is staged first: the fold releases it when the terminal
+    // frame names the very sequence it was staged under.
+    this.session.adoptDurable(entry)
+    const type = entry.event.type
+    // Only an Assistant end settles an attempt; anything else is a durable event
+    // that happens to arrive here, and the fold has already published it.
+    if (type !== 'assistant/message' && type !== 'assistant/attempt') return
+    this.end(settlement.attemptId, { kind: 'committed', eventType: type, seq: entry.event.seq })
+  }
+
+  /**
+   * Abandon one attempt that will not settle.
+   * @param attempt - the attempt to close.
+   */
+  abandon(attempt: { attemptId: string }): void {
+    if (this.released) return
+    this.end(attempt.attemptId, { kind: 'abandoned' })
+  }
+
+  /**
+   * Report the origin's running flag.
+   * @param running - whether the Session is mid-turn.
+   */
+  setRunning(running: boolean): void {
+    if (this.released) return
+    this.session.handleRunning(running)
+  }
+
+  /** Drop the Session this handle drives. Idempotent. */
+  release(): void {
+    if (this.released) return
+    this.released = true
+    this.attempts.clear()
+    this.drop()
+  }
+
+  /** Close one attempt's frame run, when it is the one this client opened. */
+  private end(
+    attemptId: string,
+    outcome:
+      | { kind: 'abandoned' }
+      | { kind: 'committed'; eventType: 'assistant/message' | 'assistant/attempt'; seq: number },
+  ): void {
+    const live = this.attempts.get(attemptId)
+    if (live === undefined) return
+    this.attempts.delete(attemptId)
+    this.frame({
+      type: 'end',
+      attemptId: attemptId as LlmAttemptId,
+      revision: live.revision,
+      index: live.nextIndex,
+      outcome: outcome.kind === 'abandoned'
+        ? { kind: 'abandoned' }
+        : {
+          kind: 'committed',
+          eventType: outcome.eventType,
+          seq: outcome.seq,
+        },
+    })
+  }
+
+  private frame(frame: SessionAssistantStreamFrame): void {
+    this.session.adoptFrame(frame)
+  }
+
+  private observe(seq: number): void {
+    if (seq > this.lastSeq) this.lastSeq = seq
+  }
+}
+
+/** Wrap wire envelopes as the entries the event window carries. */
+function entryOf(event: SessionEvent): SessionLiveEventEntry {
+  return { type: 'event', event }
+}
