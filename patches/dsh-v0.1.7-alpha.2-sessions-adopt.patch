diff --git a/packages/api/session-controller/tests/adopt.client.spec.ts b/packages/api/session-controller/tests/adopt.client.spec.ts
new file mode 100644
index 0000000000..487a577dbd
--- /dev/null
+++ b/packages/api/session-controller/tests/adopt.client.spec.ts
@@ -0,0 +1,152 @@
+/** Adopted Sessions: a window this client owns, wearing the ordinary Session the renderer binds. */
+
+import { Context } from '@deepseek-ai/cordis'
+import { describe, expect } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-api-remotes/client'
+import { SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session/types'
+import { ok, type RemoteMock } from '@deepseek-ai/dsh-remote-mock'
+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import { ClientSessions } from '../src/client/sessions/service.ts'
+import { sessionWorld } from './remote/session.client.ts'
+
+const sid = (s: string): SessionId => s as SessionId
+const API_ROSTER = webApp.closure(['@deepseek-ai/dsh-api-gateway'])
+const COLD_BOOT_TIMEOUT_MS = 60_000
+
+interface Bench {
+  ctx: Context
+  mock: RemoteMock
+  svc: ClientSessions
+}
+
+const it = createClientTest({ roster: API_ROSTER }).extend<{ bench: () => Bench }>({
+  bench: async ({ mock, start }, use) => {
+    mock.load(sessionWorld)
+    const client = await start()
+    const benches: Bench[] = []
+    try {
+      await use(() => {
+        const ctx = new Context()
+        const svc = new ClientSessions(ctx, client.ctx.remote)
+        const b: Bench = { ctx, mock, svc }
+        benches.push(b)
+        return b
+      })
+    } finally {
+      await Promise.all(benches.map(b => b.ctx.fiber.dispose()))
+    }
+  },
+})
+
+/** One durable event, in the wire shape an adopter relays. */
+function event(seq: number, type = 'turn/start'): SessionEvent {
+  return { type, seq: SessionSeq(seq), time: seq, data: { turn: seq } } as SessionEvent
+}
+
+/** Adopt a Session with one row and no verbs. */
+function adopt(b: Bench, id = 'mirror-1', title = 'Mirrored Session'): ReturnType<ClientSessions['adopt']> {
+  return b.svc.adopt({
+    sessionId: sid(id),
+    summary: { displayTitle: title, title, running: false, updatedAt: 7, cwd: '/w' },
+  })
+}
+
+describe('adopted Sessions', () => {
+  it('answers the capability a feature detects before it adopts', async ({ bench }) => {
+    const b = bench()
+    // This pair is the whole feature detection: a build that offers both can be
+    // asked to render a Session it does not own, and one that does not keeps its
+    // own pane.
+    expect(typeof b.svc.adopt).toBe('function')
+    expect(typeof b.svc.retain).toBe('function')
+  })
+
+  it('is an ordinary Session to every reader: bound, catalogued, and retainable', async ({ bench }) => {
+    const b = bench()
+    const adopted = adopt(b)
+
+    // The renderer validates a reference by comparing the service's own binding
+    // for the id, so adoption has to own the binding rather than hand one out.
+    const binding = b.svc.binding(sid('mirror-1'))
+    expect(binding?.sessionId).toBe(sid('mirror-1'))
+
+    const reference = b.svc.retain(sid('mirror-1'), { source: 'sessionSync' as never })
+    expect(reference.binding).toBe(binding)
+    await reference.ready
+
+    const state = b.svc.list.getSnapshot()
+    expect(state.ids).toContain(sid('mirror-1'))
+    expect(state.byId[sid('mirror-1')]).toMatchObject({
+      title: 'Mirrored Session', displayTitle: 'Mirrored Session', cwd: '/w', blank: false,
+    })
+
+    reference.release()
+    adopted.release()
+  }, COLD_BOOT_TIMEOUT_MS)
+
+  it('shows the window its adopter installs, and the events appended after it', async ({ bench }) => {
+    const b = bench()
+    const adopted = adopt(b)
+    adopted.replace([event(1), event(2)], false)
+
+    const window = b.svc.binding(sid('mirror-1'))?.eventSource.getSnapshot()
+    expect(window?.entries.map(entry => entry.event.seq)).toEqual([1, 2])
+    expect(window?.hasMore).toBe(false)
+
+    adopted.append(event(3))
+    expect(b.svc.binding(sid('mirror-1'))?.eventSource.getSnapshot().entries.map(e => e.event.seq))
+      .toEqual([1, 2, 3])
+
+    // Running state reaches the Session snapshot the renderer reads, not the list.
+    expect(b.svc.binding(sid('mirror-1'))?.session.getSnapshot().running).toBe(false)
+    adopted.setRunning(true)
+    expect(b.svc.binding(sid('mirror-1'))?.session.getSnapshot().running).toBe(true)
+
+    adopted.release()
+  })
+
+  it('carries a prompt to the adopter rather than to a Host that has never heard of it', async ({ bench }) => {
+    const b = bench()
+    const prompts: string[] = []
+    b.svc.adopt({
+      sessionId: sid('mirror-2'),
+      summary: { displayTitle: 'Remote', running: false, updatedAt: 1 },
+      verbs: {
+        prompt: async (content) => {
+          prompts.push(content.map(part => part.type === 'text' ? part.text : '').join(''))
+          return { ok: true, value: { accepted: true } }
+        },
+      },
+    })
+    const session = b.svc.binding(sid('mirror-2'))?.session
+    const result = await session?.prompt([{ type: 'text', text: 'hello' }], 'queue')
+    expect(result?.ok).toBe(true)
+    expect(prompts).toEqual(['hello'])
+    // Nothing was asked of the Host: the Session is local-only by construction.
+    expect(b.mock.remote.session.prompt).not.toHaveBeenCalled()
+  })
+
+  it('survives a Host list pull that does not know the Session, and goes away when released', async ({ bench }) => {
+    const b = bench()
+    const adopted = adopt(b, 'mirror-3')
+    expect(b.svc.list.getSnapshot().ids).toContain(sid('mirror-3'))
+
+    // A pull answers with the Host's own Sessions only; an omitted identity is
+    // how the wire says "removed", and an adopted row must not be read that way.
+    b.mock.remote.session.list.mockResolvedValue(ok({ items: [] }))
+    await b.svc.refresh()
+    await Promise.resolve()
+    expect(b.svc.list.getSnapshot().ids).toContain(sid('mirror-3'))
+
+    adopted.release()
+    await Promise.resolve()
+    expect(b.svc.binding(sid('mirror-3'))).toBeUndefined()
+    expect(b.svc.list.getSnapshot().ids).not.toContain(sid('mirror-3'))
+  })
+
+  it('refuses to adopt an identity the Controller already holds', async ({ bench }) => {
+    const b = bench()
+    adopt(b, 'mirror-4')
+    expect(() => adopt(b, 'mirror-4')).toThrow(/already active/)
+  })
+})
