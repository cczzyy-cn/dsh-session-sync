# Normalise source line endings to LF in the repository and on checkout, so a
# clone on any platform matches what was committed.
* text=auto eol=lf

# Committed build output and the extension patch must stay byte-identical to
# what the build and `git diff` produced: the patch has to apply with
# `git apply`, and the bundles are the artifacts the client module registry
# serves. CRLF conversion would break both.
lib/** -text
client/** -text
patches/** -text
