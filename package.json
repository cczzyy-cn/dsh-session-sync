{
  "name": "dsh-session-sync",
  "version": "0.10.30",
  "private": true,
  "description": "Multi-machine Session sync for DeepSeek Harness: publish selected Sessions to a sync server and browse every connected machine's Sessions from the left sidebar.",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/check-encoding.mjs",
    "build": "tsdown",
    "watch": "tsdown --watch",
    "check-encoding": "node scripts/check-encoding.mjs",
    "typecheck": "powershell -ExecutionPolicy Bypass -File scripts/typecheck.ps1",
    "test": "node --test --experimental-transform-types --test-concurrency=1 \"tests/*.spec.ts\"",
    "test:fast": "node --test --experimental-transform-types \"tests/*.spec.ts\"",
    "verify": "npm run check-encoding && npm run typecheck && npm test"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
